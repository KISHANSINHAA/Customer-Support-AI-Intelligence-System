# ==============================================================================
# Environment Configuration for DOTMappers AI System Sprint
# ==============================================================================

# System Settings
APP_NAME="Support Ticket AI Intelligence System"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL="sqlite:///./data/support_tickets.db"
CSV_PATH="./support_tickets.csv"

# LLM Configuration (Zero-Cost / Free-Tier Options)
# ------------------------------------------------------------------------------
# Provider options: 'groq', 'ollama', or 'auto' (defaults to 'auto')
# In 'auto' mode:
#   1. If GROQ_API_KEY is present -> Uses Groq Llama-3.3-70b (Free Tier)
#   2. Else if OLLAMA is responsive -> Uses local Ollama Llama3
#   3. Else -> Uses Intelligent Semantic Fallback (Zero configuration needed)
LLM_PROVIDER=auto

# Groq Free Tier API Key (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Settings (Optional, run: `ollama run llama3`)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Anomaly Detection Defaults
ANOMALY_IQR_MULTIPLIER=1.5
ANOMALY_SLA_URGENT_HOURS=24
ANOMALY_LOW_RATING_THRESHOLD=2
